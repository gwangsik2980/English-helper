# SQLite file for local development (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Optional. Without a key the app runs in demo mode with a scripted partner
# and rule-based feedback, which costs nothing.
ANTHROPIC_API_KEY=
# Optional model overrides (default: claude-opus-5-5 for both).
# CLAUDE_MODEL sets both; the two below override one role each.
CLAUDE_MODEL=
CLAUDE_PARTNER_MODEL=
CLAUDE_FEEDBACK_MODEL=
