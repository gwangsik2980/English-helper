# PostgreSQL. Local example below; on Neon use the pooled string ("-pooler"
# in the host) for DATABASE_URL and the direct string for DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/english_quest"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/english_quest"

# Optional. Without a key the app runs in demo mode with a scripted partner
# and rule-based feedback, which costs nothing.
ANTHROPIC_API_KEY=
# Optional model overrides (default: claude-opus-5-5 for both).
# CLAUDE_MODEL sets both; the two below override one role each.
CLAUDE_MODEL=
CLAUDE_PARTNER_MODEL=
CLAUDE_FEEDBACK_MODEL=

# Password reset mail. Without RESEND_API_KEY, development prints the reset
# link to the server console; production sends nothing (link never logged).
RESEND_API_KEY=
# Sender address on a domain verified in Resend. The default
# onboarding@resend.dev can only deliver to the Resend account owner.
MAIL_FROM=
# Public URL used in mailed links. Required in production.
APP_URL=
